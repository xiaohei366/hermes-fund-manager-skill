{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Fund Portfolio",
  "type": "object",
  "required": ["schema_version", "currency", "summary", "holdings"],
  "properties": {
    "schema_version": { "const": 1 },
    "owner": { "type": "string" },
    "currency": { "type": "string", "default": "CNY" },
    "updated_at": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["total_amount", "total_weight_percent", "holding_count"],
      "properties": {
        "total_amount": { "type": "number", "minimum": 0 },
        "total_weight_percent": { "type": "number", "minimum": 0 },
        "holding_count": { "type": "integer", "minimum": 0 }
      }
    },
    "holdings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fund_code", "fund_name", "amount", "weight_percent"],
        "properties": {
          "fund_code": { "type": "string" },
          "fund_name": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 },
          "weight_percent": { "type": "number", "minimum": 0 },
          "platform": { "type": "string" },
          "sector_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "raw_text": { "type": "string" }
        }
      }
    }
  }
}
